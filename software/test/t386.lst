                      	   407: #  FFF80000-FFF81FFF   1  2000h   8K page directory
                      	   408: #  FFF82000-FFF83FFF   1  2000h   8K page table 0
                      	   409: #  FFF84000-FFF85FFF   1  2000h   8K page table 1
                      	   410: #  FFF94000-FFF95FFF   1  2000h   8K task switch segments
                      	   411: #  FFFC0000-FFFCFFFF  8  10000h   64K stack
                      	   412: #  FFFF0000-FFFFFFFF  8  10000h   64K tests
                      	   413: #  FFF86000-FFF87FFF   1  2000h   8K used for page faults (PTE 9Fh)
                      	   414: #
                      	   415: .set PAGE_DIR_ADDR,0x2000
                      	   416: .set PAGE_TBL0_ADDR,PAGE_DIR_ADDR+0x2000
                      	   417: .set PAGE_TBL1_ADDR,PAGE_DIR_ADDR+0x4000
                      	   418: 
                      	   419: #   Now we want to build a page table. We need two pages of
                      	   420: #   8K-aligned physical memory.  We use a hard-coded address, segment 0x8000,
                      	   421: #   corresponding to physical address 0xFFF80000.
                      	   422: #
04:00001C1A 66BE002000	   423: 	mov $PAGE_DIR_ADDR,%esi
04:00001C1F 00
04:00001C20 6689F0    	   424: 	mov %esi,%eax
04:00001C23 66C1E804  	   425: 	shr $4,%eax
04:00001C27 0D0080    	   426: 	or $0x8000,%ax
04:00001C2A 8EC0      	   427: 	mov %ax,%es
                      	   428: #
                      	   429: #   Build a page table at ES:EDI (8000:0000) with only 64 valid PTEs at end,
                      	   430: #   because we're not going to access any memory outside the last 512kB.
                      	   431: #
                      	   432: # The .if is to avoid a long loop during simulation.
                      	   433: .if 0
                      	   434: 	cld
                      	   435: 	xor %edi,%edi
                      	   436: 	mov $1919,%ecx		# ECX == number of dwords to write = ((1024-64)*8)/4-1
                      	   437: 	xor %eax,%eax    	# fill PTEs with 0
                      	   438: 	rep
                      	   439: 	stosl
                      	   440: .endif
04:00001C2C 66BF001E00	   441: 	mov $7680,%edi		# index of last 64 PTEs
04:00001C31 00
04:00001C32 66B97F0000	   442: 	mov $127,%ecx			# ECX = (64 * 8) / 4 - 1
04:00001C37 00
04:00001C38 66BA0000F8	   443: 	mov $0xfff80000,%edx
04:00001C3D FF
                      	   444: .ipt1:
04:00001C3E 66B8150000	   445: 	mov $PTE_PRESENT | PTE_USER | PTE_WRITE,%eax
04:00001C43 00
04:00001C44 6601D0    	   446: 	add %edx,%eax			# add in the address
04:00001C47 66AB      	   447: 	stosl
                      	   448: 	# Bits 32 to 63 can all be zero. The high order page number is not used
                      	   449: 	# because the test system uses only a 32-bit physical address.
04:00001C49 6631C0    	   450: 	xor %eax,%eax			# page table hi order page number
04:00001C4C 66AB      	   451: 	stosl
