                      	    80: .macro updLDTDesc arg1,arg2,arg3,arg4,arg5
                      	    81: 	pushad
                      	    82: 	mov %ds,%ax
                      	    83: 	push %ax
                      	    84: 	lds %cs:ptrLDTprot,%ebx  # this macro is used in prot mode to set up prot mode env.
