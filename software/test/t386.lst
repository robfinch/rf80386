                      	   534: .shifts386FlagsTest:
                      	   535: 
                      	   536: 	# SHR al,cl - SHR ax,cl
                      	   537: 	# undefined flags:
                      	   538: 	#  CF when cl>7 (byte) or cl>15 (word):
                      	   539: 	#    if byte operand and cl=8 or cl=16 or cl=24 then CF=MSB(operand)
                      	   540: 	#    if word operand and cl=16 then CF=MSB(operand)
                      	   541: 	#  OF when cl>1: set according to result   *** rf386 calc's overflow cl>1
                      	   542: 	#  AF when cl>0: always 1
                      	   543: 	# shift count is modulo 32 so if cl=32 then result is equal to cl=0
                      	   544: 
