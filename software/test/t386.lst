                      	    95: #
                      	    96: # Updates the access byte of a descriptor in the LDT
                      	    97: # %1 LDT selector
                      	    98: # %2 access byte new value (ACC_* or'd equs)
                      	    99: # Uses DS
                      	   100: 
                      	   101: .macro updLDTDescAcc arg1,arg2
                      	   102: 	pushad
                      	   103: 	pushf
                      	   104: 	lds %cs:ptrLDTprot,%ebx
                      	   105: 	add $(\arg1) & 0xFFF8,%ebx
                      	   106: 	movb $(\arg2)>>8,5(%ebx) # acc byte
                      	   107: 	popf
                      	   108: 	popad
                      	   109: .endm
