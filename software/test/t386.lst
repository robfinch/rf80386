                      	   121: 	movb $((\arg2)>>16)&0xFF,4(%ebx) 	# BASE 23-16
                      	   122: 	movb $((\arg2)>>24)&0xFF,7(%ebx) 	# BASE 31-24
                      	   123: .endm
