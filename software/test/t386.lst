                      	   153: #
                      	   154: # Set a int gate on the IDT in protected mode
                      	   155: #
                      	   156: # %1: vector
                      	   157: # %2: offset
                      	   158: # %3: DPL, use ACC_DPL_* equs (optional)
                      	   159: #
                      	   160: # the stack must be initialized
                      	   161: #
                      	   162: .macro setProtModeIntGate arg1,arg2,arg3
                      	   163: 	pushad
                      	   164: 	pushf
                      	   165: 	mov %ds,%ax  	# save ds
                      	   166: 	push %ax
                      	   167: 	mov $\arg1,%eax
                      	   168: 	mov $\arg2,%edi
                      	   169: 	.if \arg3 != -1
                      	   170: 	mov $\arg3,%dx
                      	   171: 	.else
                      	   172: 	mov %cs,%dx
                      	   173: 	and $7,%dx
                      	   174: 	shl $13,%dx
                      	   175: 	.endif
                      	   176: 	cmp $ACC_DPL_0,%dx
                      	   177: 	jne dpl3\@
                      	   178: dpl0\@:
                      	   179: 	mov $C_SEG_PROT32,%esi
                      	   180: 	jmp cont\@
                      	   181: dpl3\@:
                      	   182: 	mov $CU_SEG_PROT32,%esi
                      	   183: cont\@:
                      	   184: 	mov %cs,%cx
                      	   185: 	test $7,%cx
                      	   186: 	jnz ring3\@
                      	   187: ring0\@:
                      	   188: 	lds (%cs:ptrIDTprot),%ebx
                      	   189: 	jmp call\@
                      	   190: ring3\@:
                      	   191: 	lds (%cs:ptrIDTUprot),%ebx
                      	   192: call\@:
                      	   193: 	call initIntGateProt
                      	   194: 	pop %ax
                      	   195: 	mov %ax,%ds  # restore ds
                      	   196: 	popf
                      	   197: 	popad
                      	   198: .endm
