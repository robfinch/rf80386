                      	   200: #
                      	   201: # Tests a fault
                      	   202: #
                      	   203: # %1: vector
                      	   204: # %2: expected error code
                      	   205: # %3: fault causing instruction (can't be a call unless the call is the faulting instruction)
                      	   206: #
                      	   207: # the stack must be initialized
                      	   208: #
                      	   209: .macro protModeFaultTest arg1,arg2,arg3
                      	   210: 	setProtModeIntGate \arg1, continue\@
                      	   211: test\@:
                      	   212: 	\arg3
                      	   213: 	jmp error
                      	   214: continue\@:
                      	   215: 	protModeExcCheck \arg1, \arg2, test\@
                      	   216: 	setProtModeIntGate \arg1, DefaultExcHandler, ACC_DPL_0
                      	   217: .endm
                      	   218: 
                      	   219: # %1: vector
                      	   220: # %2: expected error code
                      	   221: # %3: the provilege level the test code will run in
                      	   222: # %4: the expected value of pushed EIP (specify if %5 is a call, otherwise use -1)
                      	   223: # %5: fault causing code (can be a call to procedure)
                      	   224: #
                      	   225: # The fault handler is executed in ring 0. The caller must reset the data segments.
                      	   226: #
                      	   227: .macro protModeFaultTestEx arg1,arg2,arg3,arg4,arg5
                      	   228: 	setProtModeIntGate \arg1, continue\@, ACC_DPL_0
                      	   229: test\@:
                      	   230: 	\arg5
                      	   231: 	jmp error
                      	   232: continue\@:
                      	   233: 	.if \arg3 = 0
                      	   234: 		.set expectedCS,C_SEG_PROT32
                      	   235: 	.else
                      	   236: 		.set expectedCS,CU_SEG_PROT32|3
                      	   237: 	.endif
                      	   238: 	.if \arg4 = -1
                      	   239: 		protModeExcCheck \arg1, \arg2, test\@, expectedCS
                      	   240: 	.else
                      	   241: 		protModeExcCheck \arg1, \arg2, \arg4, expectedCS
                      	   242: 	.endif
                      	   243: 	setProtModeIntGate \arg1, DefaultExcHandler, ACC_DPL_0
                      	   244: .endm
                      	   245: 
                      	   246: #
                      	   247: # Checks exception result and restores the previous handler
                      	   248: #
                      	   249: # %1: vector
                      	   250: # %2: expected error code
                      	   251: # %3: expected pushed value of EIP
                      	   252: # %4: expected pushed value of CS (optional)
                      	   253: #
                      	   254: .macro protModeExcCheck arg1,arg2,arg3,arg4
                      	   255: 	.if \arg1 == 8 || (\arg1 > 10 && \arg1 <= 14)
                      	   256: 	.set exc_errcode,4
                      	   257: 	cmpl $\arg2,(%ss:%esp)
                      	   258: 	jne error
                      	   259: 	.else
                      	   260: 	.set exc_errcode,0
                      	   261: 	.endif
                      	   262: 	.if \arg4 != -1
                      	   263: 		cmpl $\arg4,exc_errcode+4(%ss:esp)
                      	   264: 		jne error
                      	   265: 	.else
                      	   266: 		mov %cs,%bx
                      	   267: 		test $7,%bx
                      	   268: 		jnz ring3\@
                      	   269: 		ring0\@:
                      	   270: 		cmpl $C_SEG_PROT32,exc_errcode+4(%ss:%esp) 
                      	   271: 		jne error
                      	   272: 		jmp continue\@
                      	   273: 		ring3\@:
                      	   274: 		cmpl $CU_SEG_PROT32|3,exc_errcode+4(%ss:%esp)
                      	   275: 		jne error
                      	   276: 		continue\@:
                      	   277: 	.endif
                      	   278: 	cmpl $\arg3,exc_errcode(%ss:%esp)
                      	   279: 	jne error
                      	   280: 	add $12+exc_errcode,%esp
                      	   281: .endm
